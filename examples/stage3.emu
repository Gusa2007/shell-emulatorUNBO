# Стартовый скрипт этапа 3: проверка команд этапов 1-3.
# Перед выполнением скрипта эмулятор загрузил VFS и вывел motd,
# отладочный вывод показывает число каталогов и файлов в VFS.

ls                          # заглушка
ls -l "My Documents" /etc   # аргументы в кавычках
cd /home/user               # заглушка
cd "/home/user/My Documents"

# Обработка ошибок
cd /a /b                    # слишком много аргументов
unknown-command             # неизвестная команда
ls 'незакрытая              # синтаксическая ошибка
exit 1 2                    # неверные аргументы exit
