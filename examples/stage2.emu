# Стартовый скрипт этапа 2.
# Комментарии оформляются как в Python: от символа # до конца строки.

ls                      # заглушка без аргументов
ls -l "My Documents"    # аргумент с пробелом в кавычках
cd '/home/user'
ls "#не комментарий" a#b   # # в кавычках и внутри слова -- аргумент
cd a b                  # ошибка: слишком много аргументов
ls "незакрытая кавычка  # ошибка синтаксиса
exit abc                # ошибка: нечисловой код
